NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Supply your existing PostgreSQL role/password/host/port; percent-encode URL characters.
DATABASE_URL=postgresql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@localhost:5432/workstudio_db
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=workstudio-api
JWT_AUDIENCE=workstudio-apps
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=15
LOGIN_FAILURE_WINDOW_MINUTES=15
EMAIL_VERIFICATION_TTL_MINUTES=1440
# Local-only: response contains a confirmation link; no email is sent or logged.
EMAIL_TRANSPORT=preview
PUBLIC_API_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
# Direct HTTPS: supply both paths. Production needs direct TLS or an HTTPS proxy.
TLS_CERT_PATH=
TLS_KEY_PATH=
# false requires STARTTLS; true uses implicit TLS (usually port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Operator provisioning only. Remove after npm run admin:create.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
