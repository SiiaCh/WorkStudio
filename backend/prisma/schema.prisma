generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMINISTRATOR
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  name                String                  @db.VarChar(100)
  email               String                  @unique @db.VarChar(254)
  passwordHash        String                  @db.VarChar(60)
  role                Role                    @default(CLIENT)
  emailVerifiedAt     DateTime?               @db.Timestamptz(3)
  failedLoginAttempts Int                     @default(0)
  lastFailedLoginAt   DateTime?               @db.Timestamptz(3)
  loginBlockedUntil   DateTime?               @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  emailVerification   EmailVerificationToken?
}

model Session {
  id             String   @id @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique @db.Char(64)
  expiresAt      DateTime @db.Timestamptz(3)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
