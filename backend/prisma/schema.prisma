generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMINISTRATOR
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  name                String                  @db.VarChar(100)
  email               String                  @unique @db.VarChar(254)
  passwordHash        String                  @db.VarChar(60)
  role                Role                    @default(CLIENT)
  emailVerifiedAt     DateTime?               @db.Timestamptz(3)
  failedLoginAttempts Int                     @default(0)
  lastFailedLoginAt   DateTime?               @db.Timestamptz(3)
  loginBlockedUntil   DateTime?               @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  emailVerification   EmailVerificationToken?
  bookings            Booking[]
  bookingSeries       BookingSeries[]
  auditLogs           AuditLog[]
  notifications       Notification[]
}

model Session {
  id             String   @id @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique @db.Char(64)
  expiresAt      DateTime @db.Timestamptz(3)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum WorkspaceStatus {
  FREE
  OCCUPIED
  UNAVAILABLE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CancellationReason {
  PAYMENT_TIMEOUT
  ADMINISTRATOR
}

model Workspace {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(100)
  type        String          @db.VarChar(100)
  location    String          @db.VarChar(200)
  description String          @db.VarChar(2000)
  status      WorkspaceStatus @default(FREE)
  mapX        Float?
  mapY        Float?
  version     Int             @default(1)
  deletedAt   DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  bookings    Booking[]
}

model Tariff {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  price     Decimal   @db.Decimal(12, 2)
  version   Int       @default(1)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  bookings  Booking[]
}

model BookingSeries {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  weekdays  Int[]
  fromDate  DateTime  @db.Date
  toDate    DateTime  @db.Date
  startTime String    @db.VarChar(5)
  endTime   String    @db.VarChar(5)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookings  Booking[]

  @@index([userId])
}

model Booking {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  workspaceId        String              @db.Uuid
  tariffId           String              @db.Uuid
  seriesId           String?             @db.Uuid
  workspaceName      String              @db.VarChar(100)
  tariffName         String              @db.VarChar(100)
  amount             Decimal             @db.Decimal(12, 2)
  startsAt           DateTime            @db.Timestamptz(3)
  endsAt             DateTime            @db.Timestamptz(3)
  status             BookingStatus       @default(PENDING_PAYMENT)
  paymentDeadline    DateTime            @db.Timestamptz(3)
  cancellationReason CancellationReason?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tariff             Tariff              @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  series             BookingSeries?      @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  notifications      Notification[]

  @@index([workspaceId, startsAt, endsAt])
  @@index([userId, startsAt])
  @@index([status, paymentDeadline])
  @@index([seriesId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  action       String   @db.VarChar(80)
  resourceType String   @db.VarChar(40)
  resourceId   String   @db.Uuid
  details      Json
  operationId  String?  @db.Uuid
  requestHash  String?  @db.Char(64)
  response     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operationId])
  @@index([resourceType, resourceId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  bookingId String    @db.Uuid
  event     String    @db.VarChar(80)
  message   String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}
